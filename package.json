    "pipeline:clips": "node scripts/pipeline/clips.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
